{


  "name": "vedic-match",


  "version": "1.0.0",


  "private": true,


  "description": "Vedic Marriage Compatibility — Vite + React + TS frontend, Express 5 + TS backend, PostgreSQL",


  "type": "module",


  "workspaces": [


    "shared",


    "server",


    "client"


  ],


  "scripts": {


    "dev": "npm run dev --workspace server & npm run dev --workspace client",


    "dev:server": "npm run dev --workspace server",


    "dev:client": "npm run dev --workspace client",


    "build": "npm run build --workspace shared && npm run build --workspace client && npm run build --workspace server",


    "start": "npm run start --workspace server",


    "typecheck": "npm run typecheck --workspaces --if-present",


    "db:push": "npm run db:push --workspace server",


    "build:shared": "npm --workspace @vedic-match/shared run build",


    "build:server": "npm --workspace @vedic-match/server run build"


  },


  "engines": {


    "node": ">=20"


  },


  "dependencies": {


    "@tiptap/react": "^3.27.3",


    "@tiptap/starter-kit": "^3.27.3",


    "bcrypt": "^6.0.0",


    "jsonwebtoken": "^9.0.3",


    "multer": "^2.2.0",


    "react-router-dom": "^7.18.1",


    "slugify": "^1.6.9"


  },


  "devDependencies": {


    "@types/bcrypt": "^6.0.0",


    "@types/jsonwebtoken": "^9.0.10",


    "@types/multer": "^2.2.0"


  }


}


